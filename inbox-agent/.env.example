# Copy to .env for local runs. In Cloud Run these are set as job env vars.

GCP_PROJECT=your-project-id
GCP_REGION=asia-south1

# GCS bucket holding the small JSON state blob (dedup + cursors).
STATE_BUCKET=your-project-id-inbox-agent-state

# Vertex AI
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=asia-south1

# Where the report is delivered, and which account sends it.
PRIMARY_EMAIL=you@example.com
COLLEGE_EMAIL=you@kgpian.iitkgp.ac.in
REPORT_TO=you@example.com

# Secret Manager secret names holding each account's OAuth refresh token bundle.
PRIMARY_SECRET=inbox-agent-primary-token
COLLEGE_SECRET=inbox-agent-college-token

# Weekly site-update job: opens PRs against this repo. Leave empty to disable.
GITHUB_REPO=CeasaKK/Placement-and-MBA
GITHUB_SECRET=inbox-agent-github-token

# Global kill switch for every mutation: mail, calendar and pull requests.
# "true" = read and report only.
DRY_RUN=true

TIMEZONE=Asia/Kolkata
