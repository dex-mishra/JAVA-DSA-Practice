{
  "name": "launch-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Placement, MBA and DSA tracker. Static site plus a small Worker API on Cloudflare.",
  "scripts": {
    "import": "node tools/import-dsa.mjs",
    "build": "node tools/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create launch-console",
    "db:init": "wrangler d1 execute launch-console --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute launch-console --local --file=./schema.sql",
    "test": "node --test worker/*.test.mjs tools/*.test.mjs",
    "check": "node --check src/app.js && node tools/import-dsa.mjs --check && npm test && node tools/verify-dsa.mjs --if-gxx",
    "verify:dsa": "node tools/verify-dsa.mjs",
    "db:migrate": "wrangler d1 execute launch-console --remote --file=./migrations/0004_dsa_ai.sql",
    "db:migrate:local": "wrangler d1 execute launch-console --local --file=./migrations/0004_dsa_ai.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
