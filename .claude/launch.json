{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "console/.venv/bin/python console/main.py"
      ],
      "port": 8080
    },
    {
      "name": "worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}